# Copy to .env and edit.  ->  cp env.example .env

# REQUIRED unless you bind to loopback. Generate one with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# Treat this like a root password for the host: anyone holding it can read
# your telemetry and, if ENABLE_SCRIPTS=1, run root scripts on the machine.
DASH_TOKEN=

# What the page calls this box.
SITE_NAME=V620

# Your timezone, e.g. America/New_York
TZ=UTC

# llama-swap lane (leave as-is if llama-swap runs on the host, port 8090)
LANE_URL=http://host.docker.internal:8090

# Ollama endpoint. EMPTY = llama.cpp-only box; the Ollama UI hides itself.
OLLAMA_URL=
